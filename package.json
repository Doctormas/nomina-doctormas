{
  "name": "nomina-doctormas",
  "version": "1.0.2",
  "description": "Sistema de nómina Doctormás — conforme a la LOTTT (Venezuela)",
  "author": "Doctormás",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Doctormas/nomina-doctormas.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "ELECTRON_ENABLE_LOGGING=1 electron . --dev",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder -mw",
    "release:win": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.doctormas.nomina",
    "productName": "Nómina Doctormás",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Doctormas",
      "repo": "nomina-doctormas",
      "releaseType": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "node_modules/xlsx/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.business"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    }
  }
}
